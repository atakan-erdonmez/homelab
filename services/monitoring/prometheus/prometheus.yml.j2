global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "pve01-node"
    static_configs:
      - targets:
          - 'pve01.int.atakan-erdonmez.com:9100'


  - job_name: "PVE exporter"
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["1"]
      node: ["1"]
      target: ["pve01.int.atakan-erdonmez.com"]
    static_configs:
      - targets: ["pve-exporter:9221"]
